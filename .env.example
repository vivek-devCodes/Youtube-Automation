# Copy to .env and fill in. NEVER commit .env. Every value here is optional for a first local run.
# Generate secrets with:  python scripts/gen_keys.py

# ---- Core ------------------------------------------------------------------
ENVIRONMENT=development            # development | production
SECRET_KEY=change-me-long-random-string
ENCRYPTION_KEY=                    # Fernet key; REQUIRED in production (encrypts OAuth tokens + API keys)
PUBLIC_BASE_URL=http://localhost:3000   # where your browser opens the app (http://localhost with Docker)
CORS_ORIGINS=http://localhost:3000

# ---- Database / jobs (Docker Compose overrides these) -----------------------
# DATABASE_URL=postgresql+psycopg://studio:studio@localhost:5432/studio
# REDIS_URL=redis://localhost:6379/0
TASK_MODE=inline                   # inline (no Redis) | celery
POSTGRES_USER=studio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=studio

# ---- Google / YouTube (docs/SETUP_GOOGLE.md) --------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=                   # read-only key for trend discovery
YOUTUBE_DAILY_QUOTA=10000
YOUTUBE_UPLOAD_QUOTA_COST=1600     # units per videos.insert — check your Cloud Console quota page
ENABLE_PLAYLIST_SCOPE=false        # adds the broad 'youtube' scope so videos can be added to playlists
ENABLE_MONETARY_ANALYTICS=false    # adds revenue scope (only useful once monetised)

# ---- AI providers (optional: keys can also be saved encrypted in the UI) ------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
KOKORO_BASE_URL=                   # e.g. http://localhost:8880
PIPER_BASE_URL=                    # e.g. http://localhost:5000
COMFYUI_BASE_URL=                  # e.g. http://localhost:8188

# ---- Research ---------------------------------------------------------------
RESEARCH_CONTACT=                  # your site URL or ops email; Wikipedia rejects anonymous bots

# ---- Storage ----------------------------------------------------------------
STORAGE_BACKEND=local              # local | s3 (mirrors finished videos to S3 / Cloudflare R2)
S3_BUCKET=
S3_ENDPOINT_URL=                   # R2: https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# ---- Monitoring -------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=INFO
GRAFANA_PASSWORD=change-me
